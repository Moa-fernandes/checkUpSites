import copy
import json
import os
import re
import threading
import time
import uuid
from datetime import datetime
from pathlib import Path

import requests
from flask import Flask, Response, jsonify, make_response, redirect, render_template, request, stream_with_context, url_for

from checker import DEFAULT_LIVE_TARGETS, check_live_targets, check_site, check_site_steps
from storage import Storage

BASE_DIR = Path(__file__).resolve().parent
VISITOR_COOKIE = "checkup_vid"
OWNER_NAME = os.environ.get("CHECKUP_OWNER", "Moacir")
CONTACT_EMAIL = os.environ.get("CHECKUP_CONTATO", "moacirsistemax@gmail.com")
PIX_KEY = os.environ.get("CHECKUP_PIX_KEY", "moacirsistemax@gmail.com")
LIVE_TTL_SECONDS = 45
AUDIT_CACHE_TTL_SECONDS = 90
AUDIT_CACHE_MAX_ITEMS = 32
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def _min_scan_seconds() -> float:
    """Tempo mínimo da animação de carregamento. Nunca abaixo de 18 s."""
    try:
        value = float(os.environ.get("CHECKUP_MIN_SCAN_SECONDS", "18"))
    except ValueError:
        value = 18.0
    return max(18.0, value)


MIN_SCAN_SECONDS = _min_scan_seconds()


def _parse_live_targets() -> list[dict]:
    raw_json = os.environ.get("CHECKUP_LIVE_TARGETS", "").strip()
    if raw_json:
        try:
            parsed = json.loads(raw_json)
            if isinstance(parsed, list) and parsed:
                return parsed
        except Exception:
            pass
    return DEFAULT_LIVE_TARGETS


def _cache_key_for_url(raw_url: str) -> str:
    val = (raw_url or "").strip()
    if not val:
        return ""
    if not val.startswith(("http://", "https://")):
        val = "https://" + val
    return val.rstrip("/").lower()


def create_app(
    base_dir: Path = BASE_DIR,
    site_checker=check_site,
    site_step_checker=check_site_steps,
    live_checker=check_live_targets,
) -> Flask:
    app = Flask(__name__)
    store = Storage(Path(base_dir))
    live_targets = _parse_live_targets()
    live_cache = {"ts": 0.0, "items": []}
    audit_cache: dict[str, tuple[float, dict]] = {}
    cache_lock = threading.Lock()

    live_state = {"refreshing": False}
    live_lock = threading.Lock()

    def _refresh_live_status() -> None:
        try:
            items = live_checker(live_targets)
            with live_lock:
                live_cache["items"] = items
                live_cache["ts"] = time.monotonic()
        except Exception:
            app.logger.exception("Falha ao consultar alvos ao vivo")
        finally:
            with live_lock:
                live_state["refreshing"] = False

    def _start_live_refresh() -> None:
        with live_lock:
            if live_state["refreshing"]:
                return
            live_state["refreshing"] = True
        threading.Thread(target=_refresh_live_status, daemon=True).start()

    def get_live_status(force: bool = False) -> list[dict]:
        """Nunca bloqueia a página de entrada: devolve o último cache e atualiza em segundo plano."""
        if force:
            _refresh_live_status()
            return live_cache["items"]
        stale = (time.monotonic() - live_cache["ts"]) > LIVE_TTL_SECONDS
        if stale or not live_cache["items"]:
            _start_live_refresh()
        return live_cache["items"]

    def get_cached_audit(raw_url: str, force: bool = False) -> dict | None:
        if force:
            return None
        key = _cache_key_for_url(raw_url)
        if not key:
            return None
        now = time.monotonic()
        with cache_lock:
            entry = audit_cache.get(key)
            if entry and (now - entry[0]) <= AUDIT_CACHE_TTL_SECONDS:
                return copy.deepcopy(entry[1])
            if entry:
                audit_cache.pop(key, None)
        return None

    def put_cached_audit(raw_url: str, result: dict) -> None:
        now = time.monotonic()
        keys = {_cache_key_for_url(raw_url), _cache_key_for_url(result.get("url", ""))}
        keys.discard("")
        if not keys:
            return
        with cache_lock:
            if len(audit_cache) >= AUDIT_CACHE_MAX_ITEMS:
                oldest_key = min(audit_cache.items(), key=lambda kv: kv[1][0])[0]
                audit_cache.pop(oldest_key, None)
            snapshot = copy.deepcopy(result)
            for k in keys:
                audit_cache[k] = (now, snapshot)

    @app.context_processor
    def inject_globals():
        return {
            "owner": OWNER_NAME,
            "year": datetime.now().year,
            "stats": store.get_stats(),
            "pix_key": PIX_KEY,
        }

    def render_home(**kwargs):
        live_data = get_live_status(force=False)
        context = {
            "result": None,
            "comparison": None,
            "error": None,
            "url": "",
            "waitlist_ok": False,
            "waitlist_error": None,
            "live_targets": live_data,
            "live_items": live_data,
        }
        context.update(kwargs)
        return render_template("index.html", **context)

    flash_store: dict[str, dict] = {}
    FLASH_TTL_S = 300.0

    def _save_flash(ctx: dict) -> str:
        token = uuid.uuid4().hex[:16]
        with cache_lock:
            if len(flash_store) >= 64:
                flash_store.pop(next(iter(flash_store)))
            flash_store[token] = {"ts": time.monotonic(), "ctx": ctx}
        return token

    def _load_flash(token: str) -> dict | None:
        with cache_lock:
            entry = flash_store.get(token)
            if not entry:
                return None
            if (time.monotonic() - entry["ts"]) > FLASH_TTL_S:
                flash_store.pop(token, None)
                return None
            return copy.deepcopy(entry["ctx"])

    @app.route("/", methods=["GET", "POST"])
    def index():
        if request.method == "GET":
            visitor_id = request.cookies.get(VISITOR_COOKIE)
            new_id = None
            if not visitor_id:
                visitor_id = uuid.uuid4().hex
                new_id = visitor_id
            try:
                store.record_page_view(new_id)
            except Exception:
                app.logger.exception("Falha ao registrar visita")

            # GET nunca dispara auditoria: apenas exibe um resultado já gravado.
            token = (request.args.get("r") or "").strip()
            ctx = _load_flash(token) if token else None
            response = make_response(render_home(**(ctx or {})))
            response.headers["Cache-Control"] = "no-store"
            response.set_cookie(
                VISITOR_COOKIE,
                visitor_id,
                max_age=60 * 60 * 24 * 365 * 2,
                httponly=True,
                samesite="Lax",
            )
            return response

        # POST: única forma de iniciar uma auditoria. Responde com redirecionamento (PRG),
        # então restaurar a aba do navegador repete apenas um GET inofensivo.
        url = request.form.get("url", "").strip()
        force = request.form.get("force") == "1"
        try:
            checked = get_cached_audit(url, force=force)
            if checked is None:
                checked = site_checker(url)
                put_cached_audit(url, checked)
            checked["requested_url"] = url
            try:
                comp = store.record_and_compare_history(checked, requested_url=url)
            except Exception:
                app.logger.exception("Falha ao gravar histórico de %s", url)
                comp = None
            token = _save_flash({"result": checked, "comparison": comp, "url": url})
        except ValueError as exc:
            token = _save_flash({"error": str(exc), "url": url})
        except requests.RequestException:
            token = _save_flash({
                "error": "Não consegui acessar esse site. Confira o endereço e tente de novo.",
                "url": url,
            })
        except Exception:
            app.logger.exception("Falha ao verificar %s", url)
            token = _save_flash({
                "error": "Algo deu errado ao verificar este site. Tente novamente em instantes.",
                "url": url,
            })
        return redirect(url_for("index", r=token), code=303)

    @app.route("/.well-known/appspecific/com.chrome.devtools.json", methods=["GET"])
    def chrome_devtools_well_known():
        return ("", 204)

    @app.route("/status/ao-vivo")
    def status_ao_vivo():
        force = request.args.get("force") == "1"
        return jsonify({"items": get_live_status(force=force)})

    @app.route("/verificar/stream", methods=["POST"])
    def verificar_stream():
        payload = request.get_json(silent=True) or {}
        url = str(payload.get("url") or request.form.get("url") or "").strip()
        force = bool(payload.get("force")) or (request.form.get("force") == "1")

        @stream_with_context
        def generate():
            started = time.monotonic()

            def hold_until(percent: float) -> None:
                # Respeita o tempo mínimo de raspagem: cada marco de progresso
                # só é liberado após a fração correspondente de MIN_SCAN_SECONDS.
                remaining = (MIN_SCAN_SECONDS * float(percent) / 100.0) - (time.monotonic() - started)
                if remaining > 0:
                    time.sleep(remaining)

            def line(obj: dict) -> str:
                return json.dumps(obj, ensure_ascii=False) + "\n"

            try:
                cached = get_cached_audit(url, force=force)
                if cached is not None:
                    hold_until(20)
                    yield line({"type": "progress", "percent": 20, "step": "Recuperando auditoria recente em cache..."})
                    hold_until(55)
                    yield line({"type": "progress", "percent": 55, "step": "Montando o relatório com os dados já verificados..."})
                    cached["requested_url"] = url
                    cached["from_cache"] = True
                    comp = store.record_and_compare_history(cached, requested_url=url)
                    rendered_html = render_template("_resultado.html", result=cached, comparison=comp)
                    hold_until(100)
                    yield line({"type": "done", "html": rendered_html})
                    return

                for event in site_step_checker(url):
                    if event.get("type") == "done":
                        checked = event["result"]
                        put_cached_audit(url, checked)
                        checked["requested_url"] = url
                        checked["from_cache"] = False
                        comp = store.record_and_compare_history(checked, requested_url=url)
                        rendered_html = render_template(
                            "_resultado.html",
                            result=checked,
                            comparison=comp,
                        )
                        hold_until(100)
                        yield line({"type": "done", "html": rendered_html})
                    else:
                        if event.get("type") == "progress":
                            hold_until(float(event.get("percent") or 0))
                        yield line(event)
            except ValueError as exc:
                yield line({"type": "error", "message": str(exc)})
            except requests.RequestException:
                yield line({
                    "type": "error",
                    "message": "Não consegui acessar esse site. Confira o endereço e tente de novo.",
                })
            except Exception:
                app.logger.exception("Falha no stream ao verificar %s", url)
                yield line({
                    "type": "error",
                    "message": "Algo deu errado ao verificar este site. Tente novamente em instantes.",
                })

        return Response(generate(), mimetype="application/x-ndjson; charset=utf-8")

    @app.route("/avisar", methods=["POST"])
    def avisar():
        email = request.form.get("email", "").strip().lower()
        if not EMAIL_RE.match(email):
            return render_home(waitlist_error="Digite um e-mail válido.")
        store.add_waitlist_email(email)
        return render_home(waitlist_ok=True)

    @app.route("/privacidade")
    def privacidade():
        return render_template(
            "privacidade.html",
            contact=CONTACT_EMAIL,
            updated=datetime.now().strftime("%d/%m/%Y"),
        )

    @app.route("/favicon.ico")
    def favicon():
        return redirect(url_for("static", filename="favicon.svg"), code=301)

    @app.errorhandler(404)
    def not_found(_):
        return render_template(
            "erro.html",
            code=404,
            message="A página que você procura não existe ou foi movida.",
        ), 404

    @app.errorhandler(500)
    def server_error(_):
        return render_template(
            "erro.html",
            code=500,
            message="Algo deu errado do nosso lado. Tente novamente em instantes.",
        ), 500

    return app


app = create_app()

if __name__ == "__main__":
    app.run(debug=True)